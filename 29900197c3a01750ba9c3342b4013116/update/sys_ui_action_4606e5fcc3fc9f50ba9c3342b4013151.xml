        <name>Acknowledge Response</name>
        <onclick/>
        <order>100</order>
        <script><![CDATA[(function executeAction() {

	if(current.getValue('response_acknowledged') == 'true') {
		gs.addInfoMessage('Response has already been acknowledged.');
		action.setRedirectURL(current);
		return;
	}

	current.setValue('response_acknowledged', true);
	current.setValue('response_acknowledged_at', new GlideDateTime());

	current.update();
	gs.addInfoMessage('Major Incident response acknowledged successfully.');

	action.setRedirectURL(current);
})();]]></script>
